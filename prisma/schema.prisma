// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:N Relation with ChatMember
  memberships ChatMember[]

  @@map("users")
}

model Chat {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:N Relation with ChatMember
  members ChatMember[]

  @@map("chats")
}

model ChatMember {
  chatId   String
  userId   String
  joinedAt DateTime @default(now())

  // N:1 Relations with Chat and User
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite Primary Key: Ensures a user cannot be added twice to the same chat
  @@id([chatId, userId])
  // Index on userId for fast queries (e.g. fetch all chats for a user)
  @@index([userId])
  @@map("chat_members")
}
